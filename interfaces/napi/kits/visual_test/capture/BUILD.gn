import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")

config("rendercapture_config") {
  include_dirs = [
    "$ace_root",
    "$ace_root/frameworks",
  ]
}

ohos_shared_library("rendercapture") {
  output_name = "capture"
  sources = [
    "render_capture_napi.cpp",
    "subscription_manager.cpp",
  ]
  public = [
    "rendercapture.h",
    "file_utils.h",
    "subscription_manager.h",
  ]

  configs = [
    "$ace_root:ace_config",
    ":rendercapture_config",
  ]

  deps = [
    "$ace_root/build:libace_compatible",
  ]
  external_deps = [ "napi:ace_napi" ]

  if (defined(ohos_previewer)) {
    sources += [ "render_capture_preview.cpp" ]
  } else {
    sources += [ "render_capture_device.cpp" ]
    deps += [
      "//foundation/arkui/ace_engine/frameworks/core/components_ng/render:ace_core_components_render_ng_ohos",
    ]
  }

  relative_install_dir = "module/arkui/visualtest"
  part_name = ace_engine_part
  subsystem_name = ace_engine_subsystem
}
