import("//build/ohos.gni")
import("//foundation/arkui/ace_engine/ace_config.gni")

ohos_shared_library("ace_network") {
  if (target_os == "ohos" && !is_arkui_x) {
    sources = [ "download_manager_impl.cpp" ]
  } else {
    sources = [ "download_manager_crossplatform.cpp" ]
  }
  configs = [ "$ace_root:ace_config" ]
  
  defines = []
  if (target_os == "ohos" && !is_arkui_x) {
    defines += [ "OHOS_PLATFORM" ]
    external_deps = [  
      "curl:curl_shared",
      "hilog:libhilog",
      "netmanager_base:net_conn_manager_if",
      "netmanager_base:net_conn_parcel",
      "netstack:http_client",
      "napi:ace_napi",
      "request:preload_napi",
      "request:preload_native",
      "samgr:samgr_proxy",
      ]
  } else if (target_os == "android") {
    defines += [ "ANDROID_PLATFORM" ]
    deps = [ "//plugins/request/cachedownload:cache_download_core_android" ]
    libs = [ "log" ]
  } else if (target_os == "ios") {
    defines += [ "IOS_PLATFORM" ]
    ldflags = [ "-Wl", "-install_name", "@rpath/libace_network.framework/libace_network" ]
    deps = [ "//plugins/request/cachedownload:cache_download_core_ios" ]
  }
  subsystem_name = ace_engine_subsystem
  innerapi_tags = [ "platformsdk_indirect" ]
  part_name = ace_engine_part
}
