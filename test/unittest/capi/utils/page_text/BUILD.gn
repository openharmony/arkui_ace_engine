import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

# Compile the original public error getter without the unrelated node utilities.
action("page_text_error_getter") {
  testonly = true
  script = "../extract_page_text_error_getter.py"
  inputs = [ "$ace_root/interfaces/native/node/node_utils.cpp" ]
  outputs = [ "$target_gen_dir/page_text_error_getter.cpp" ]
  args = [
    rebase_path(inputs[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
  ]
}

# Keep allocation fault injection and NodeModel stubs local to this executable.
ohos_unittest("capi_page_text_test") {
  module_out_path = "ace_engine/C-API-Main"
  sources = [
    "$ace_root/frameworks/core/interfaces/native/utility/error_message_manager.cpp",
    "$ace_root/interfaces/native/native_error_message_wrapper.cpp",
    "$ace_root/interfaces/native/ui_info_collection.cpp",
    "$ace_root/interfaces/native/ui_json_wrapper.cpp",
    "../page_text_capi_test.cpp",
  ]
  sources += get_target_outputs(":page_text_error_getter")
  deps = [ ":page_text_error_getter" ]
  include_dirs = [
    "$ace_root",
    "$ace_root/frameworks",
    "$ace_root/interfaces/native",
    "$ace_root/interfaces/inner_api/ace_kit/include",
  ]
  external_deps = [ "bounds_checking_function:libsec_static" ]
  defines = [ "ARKUI_CAPI_UNITTEST" ]
  cflags_cc = [
    "-std=c++17",

    # The wrapper's uint32_t/size_t overflow check is only needed on 32-bit.
    "-Wno-tautological-constant-out-of-range-compare",
  ]
  cflags = [
    "-fno-builtin-malloc",
    "-fno-builtin-realloc",
  ]
  ldflags = [
    "-Wl,--wrap=malloc",
    "-Wl,--wrap=realloc",
  ]
}
