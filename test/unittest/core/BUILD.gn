import("//build/test.gni")

group("core_unittest") {
  testonly = true
  deps = []
  if (is_host_product) {
    deps += [
      "common:common_test",
      "manager:content_change_manager_test_ng",
      "manager:display_sync_manager_test_ng",
      "manager:full_screen_manager_test_ng",
      "base:core_base_unittest",
      "common/others:thread_checker_test",
      "layout:core_layout_unittest",
      "layout/safe_area:ignore_layout_safe_area_scheduling_test_ng",
      "common/ime:ime_test",
      "manager:page_scene_rule_manager_test_ng",
      "manager:safe_area_manager_test_ng",
      "manager:select_overlay_manager_test_ng",
      "manager:select_overlay_proxy_test_ng",
      "pattern:core_pattern_unittest",
      "property:border_property_test_ng",
      "property:calc_length_test_ng",
      "property:grid_property_test_ng",
      "property:layout_constraint_test_ng",
      "render:render_context_test_ng",
      "render:render_property_test_ng",
      "syntax:core_syntax_unittest",
      "animation:callback_thread_wrapper_test",
      "common/resource:resource_manager_test",
      "common/resource:resource_parse_utils_test_ng",
      "manager:avoid_info_manager_test_ng",
      "manager:navigation_manager_test_ng",
      "manager:theme_manager_test_ng",
      ":navigation_controller_test",
    ]
  } else {
    deps = [
      "accessibility:core_accessibility_unittest",
      "animation:core_animation_unittest",
      "base:core_base_unittest",
      "common:core_common_unittest",
      "components:core_components_unittest",
      "event:core_event_unittest",
      "gestures:gestures_test_ng",
      "image:image_file_cache_test_ng",
      "image:image_loader_test",
      "image:image_provider_test_ng",
      "interfaces:core_interfaces_unittest",
      "layout:core_layout_unittest",
      "manager:core_manager_unittest",
      "pattern:core_pattern_unittest",
      "pipeline:pipeline_context_test_ng",
      "property:core_property_unittest",
      "render:core_render_unittest",
      "rosen:arkui_rosen_render_context_test",
      "rosen:gradient_style_modifier_test",
      "svg:core_svg_unittest",
      "syntax:core_syntax_unittest",
    ]
  }
}

if (is_host_product) {
  ace_root = "//foundation/arkui/ace_engine"
  executable("navigation_controller_test") {
    testonly = true
    sources = [
      "$ace_root/interfaces/inner_api/ace/navigation_controller.cpp",
      "$ace_root/interfaces/inner_api/ace/ace_forward_compatibility.cpp",
      "$ace_root/test/unittest/interfaces/navigation_controller_test.cpp",
    ]
    include_dirs = [
      "$ace_root/interfaces/inner_api/ace",
      "$ace_root/test/mock/frameworks/core/osal/mock_hilog",
      "//third_party/googletest/googletest/include",
      "//third_party/googletest/googlemock/include",
    ]
    configs += [ "$ace_root/test/unittest:ace_unittest_config" ]
    deps = [ "$ace_root/test/unittest:ace_components_deps" ]
    defines = [ "ACE_HOST_PRODUCT" ]
  }
}
