import("//foundation/arkui/ace_engine/test/unittest/ace_unittest.gni")

if (is_host_product) {
  ace_unittest("lazy_grid_layout_test") {
    type = "host_components"
    cflags = [ "-fno-access-control" ]
    module_name = "ScrollingSet-LazyVGridLayout"
    sources = [
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/bridge/lazy_grid_layout_dynamic_modifier.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/bridge/lazy_grid_layout_static_modifier.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_algorithm.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_info.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_model.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_model_static.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_pattern.cpp",
      "grid_layout/lazy_grid_generated_layout_test.cpp",
      "grid_layout/lazy_grid_layout_header_footer_test.cpp",
      "grid_layout/lazy_grid_layout_item_fill_policy_test.cpp",
      "grid_layout/lazy_grid_layout_syntax_test.cpp",
      "grid_layout/lazy_grid_layout_test.cpp",
      "grid_layout/lazy_grid_pattern_test.cpp",
      "lazy_layout_test_core.cpp",
      "lazy_layout_test_min.cpp",
      "lazy_layout_test_utils.cpp",
    ]
    include_dirs =
        [ "$ace_root/frameworks/core/interfaces/native/generated/interface" ]
  }
} else {
  ace_unittest("lazy_grid_layout_test") {
    module_name = "ScrollingSet-LazyVGridLayout"
    type = "new"
    sources = [
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/bridge/lazy_grid_layout_dynamic_modifier.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/bridge/lazy_grid_layout_static_modifier.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_algorithm.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_info.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_model.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_model_static.cpp",
      "$ace_root/frameworks/core/components_ng/pattern/lazy_grid_layout/lazy_grid_layout_pattern.cpp",
      "grid_layout/lazy_grid_generated_layout_test.cpp",
      "grid_layout/lazy_grid_layout_header_footer_test.cpp",
      "grid_layout/lazy_grid_layout_item_fill_policy_test.cpp",
      "grid_layout/lazy_grid_layout_syntax_test.cpp",
      "grid_layout/lazy_grid_layout_test.cpp",
      "grid_layout/lazy_grid_pattern_test.cpp",
      "lazy_layout_test_utils.cpp",
    ]
    include_dirs =
        [ "$ace_root/frameworks/core/interfaces/native/generated/interface" ]

    # idlize_gen is a generation precondition, not a functional test dependency:
    # it regenerates the tracked arkoala_api_generated.h from the SDK in the build
    # tree, so this target requires an SDK that already contains the
    # LazyVGridLayout columnsTemplate(string | ItemFillPolicy) overload.
    deps = [
      "$ace_root/frameworks/bridge/arkts_frontend/arkoala_generator:idlize_gen",
    ]

    if (!ace_enable_full_test_suite) {
      sources -= [
        "lazy_layout_test_core.cpp",
        "lazy_layout_test_min.cpp",
      ]
    } else {
      sources += [
        "lazy_layout_test_core.cpp",
        "lazy_layout_test_min.cpp",
      ]
    }
  }
}

